FROM eclipse-temurin:25-jdk-jammy
LABEL authors="edsf"

WORKDIR /workspace

COPY gradlew .
COPY gradle gradle
COPY settings.gradle.kts .
COPY build.gradle.kts .

RUN chmod +x gradlew
RUN ./gradlew dependencies

ENV DEBUG_PORT=5005

CMD ["sh", "-c", "./gradlew classes && (./gradlew classes --continuous --quiet &) && ./gradlew bootRun"]